<UserControl x:Class="YFrame.View.UC.Toolbox.Md5CompareTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="720">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{DynamicResource key_Toolbox_Md5Compare}"
                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

        <!-- 文件 A -->
        <Border Grid.Row="1" Padding="8" CornerRadius="5"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                AllowDrop="True" Tag="A">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource key_Toolbox_Browse}"
                            Command="{Binding SelectFileACommand}" Padding="10,3" MinHeight="24"/>
                    <TextBlock Text="{DynamicResource key_Toolbox_FileA}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="90"/>
                    <TextBox Text="{Binding FileAPath, Mode=OneWay}" IsReadOnly="True"
                             Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="90,6,0,0">
                    <TextBlock Text="{Binding FileAInfo}" FontSize="11"
                               Foreground="{DynamicResource TreeItemSecondaryText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 文件 B -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" CornerRadius="5"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                AllowDrop="True" Tag="B">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource key_Toolbox_Browse}"
                            Command="{Binding SelectFileBCommand}" Padding="10,3" MinHeight="24"/>
                    <TextBlock Text="{DynamicResource key_Toolbox_FileB}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Width="90"/>
                    <TextBox Text="{Binding FileBPath, Mode=OneWay}" IsReadOnly="True"
                             Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="90,6,0,0">
                    <TextBlock Text="{Binding FileBInfo}" FontSize="11"
                               Foreground="{DynamicResource TreeItemSecondaryText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 计算按钮 + 进度 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="{DynamicResource key_Toolbox_ComputeMd5}"
                        Command="{Binding ComputeCommand}" FontWeight="SemiBold"
                        Padding="16,6"/>
                <Button Content="{DynamicResource key_Toolbox_Clear}"
                        Command="{Binding ClearCommand}" Margin="8,0,0,0" Padding="12,6"/>
            </StackPanel>
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}"
                         Height="8" VerticalAlignment="Center" Margin="16,0"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource TreeItemAccent}"/>
            <TextBlock Grid.Column="2" Text="{Binding ProgressPercent}" FontFamily="Consolas"
                       Foreground="{DynamicResource TreeItemSecondaryText}" VerticalAlignment="Center" Width="42"/>
        </Grid>

        <!-- MD5 结果 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource key_Toolbox_Md5A}"
                       Foreground="{DynamicResource TreeItemSecondaryText}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FileAHash, Mode=OneWay}"
                     IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,4"/>
            <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource key_Toolbox_Copy}"
                    Command="{Binding CopyHashACommand}" Padding="10,3" MinHeight="24" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource key_Toolbox_Md5B}"
                       Foreground="{DynamicResource TreeItemSecondaryText}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FileBHash, Mode=OneWay}"
                     IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0"/>
            <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource key_Toolbox_Copy}"
                    Command="{Binding CopyHashBCommand}" Padding="10,3" MinHeight="24"/>
        </Grid>

        <!-- 结果状态 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
            <Ellipse Width="10" Height="10" Fill="{Binding ResultBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource TextBrush}"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="6" Text="{DynamicResource key_Toolbox_Md5Hint}"
                   Foreground="{DynamicResource TreeItemSecondaryText}" FontSize="11"
                   VerticalAlignment="Bottom" TextWrapping="Wrap"/>
    </Grid>
</UserControl>